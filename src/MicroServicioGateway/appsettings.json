{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "auth-route": {
                "ClusterId": "auth-cluster",
                "Match": { "Path": "/gateway/auth/{**catch-all}" },
                "Transforms": [ { "PathPattern": "/api/{**catch-all}" } ]
            },
            "usuarios-route": {
                "ClusterId": "usuarios-cluster",
                "Match": { "Path": "/gateway/usuarios/{**catch-all}" },
                "Transforms": [ { "PathPattern": "/api/usuario/{**catch-all}" } ]
            },
            "fotografias-route": {
                "ClusterId": "fotografias-cluster",
                "Match": { "Path": "/gateway/fotografias/{**catch-all}" },
