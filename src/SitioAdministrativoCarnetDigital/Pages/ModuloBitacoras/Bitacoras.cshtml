@page
@model SitioAdministrativoCarnetDigital.Pages.ModuloBitacoras.BitacorasModel
@{
    ViewData["Title"] = "Bitácoras";
    ViewData["Section"] = "Registro de Bitácoras";
}

<style>
    .card-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .tabla {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .tabla th {
            background-color: var(--content-bg);
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
        }

        .tabla td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
            word-break: break-word;
        }

        .tabla tr:hover {
            background-color: var(--content-bg);
        }

    .alert-error {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
    }

    .filtros {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

        .filtros input {
            flex: 1;
            min-width: 150px;
            padding: 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 14px;
            outline: none;
        }

        .filtros label {
            font-size: 12px;
            color: var(--text-secondary);
            display: block;
            margin-bottom: 4px;
        }

    .filtro-grupo {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 150px;
    }
</style>

<div class="page-title">Registro de Bitácoras</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert-error">@Model.MensajeError</div>
}

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
        <h2 class="card-title">Listado de Bitácoras</h2>
    </div>

    <form method="get" class="filtros">
        <div class="filtro-grupo">
            <label>Fecha</label>
            <input type="date" name="fecha" value="@Model.FiltroFecha">
        </div>
        <div class="filtro-grupo">
            <label>Usuario (ID)</label>
            <input type="text" name="usuario" value="@Model.FiltroUsuario" placeholder="ID del usuario...">
        </div>
        <div class="filtro-grupo">
            <label>Acción</label>
            <input type="text" name="accion" value="@Model.FiltroAccion" placeholder="Buscar acción...">
        </div>
        <div style="display:flex;align-items:flex-end;gap:8px">
            <button class="btn btn-primary" type="submit">Filtrar</button>
            <a class="btn btn-secondary" asp-page="/ModuloBitacoras/Bitacoras">Limpiar</a>
        </div>
    </form>

    <table class="tabla">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Descripción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Bitacoras)
            {
                <tr>
                    <td>@b.FechaHora?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@b.UsuarioID</td>
                    <td>@b.Descripcion</td>
                </tr>
            }
            @if (!Model.Bitacoras.Any())
            {
                <tr><td colspan="3" style="text-align:center;color:var(--text-secondary);padding:20px">No hay bitácoras registradas.</td></tr>
            }
        </tbody>
    </table>
</div>