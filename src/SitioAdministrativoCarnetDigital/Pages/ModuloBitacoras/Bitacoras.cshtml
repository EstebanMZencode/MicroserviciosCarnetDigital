@page
@model SitioAdministrativoCarnetDigital.Pages.ModuloBitacoras.BitacorasModel
@{
    ViewData["Title"] = "Bitácoras";
    ViewData["Section"] = "Bitácoras";
}

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Registro de Bitácoras</h2>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar por usuario o acción...">
    <button class="btn btn-secondary" type="submit">Buscar</button>
</form>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Fecha</th>
            <th>Usuario</th>
            <th>Descripción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.Bitacoras)
        {
            <tr>
                <td>@b.FechaHora?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@b.UsuarioID</td>
                <td>@b.Descripcion</td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPaginas; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" asp-page="/ModuloBitacoras/Bitacoras" asp-route-page="@i" asp-route-busqueda="@Model.Busqueda">@i</a>
            </li>
        }
    </ul>
</nav>