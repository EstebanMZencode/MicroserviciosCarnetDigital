@page
@model SitioAdministrativoCarnetDigital.Pages.ModuloRoles.RolesModel
@{
    ViewData["Title"] = "Roles";
    ViewData["Section"] = "Administración de Roles";
    var paginaActual = Model.PaginaActual;
    // Escapar comillas simples para que los strings sean seguros al inyectarlos en JS
    var msgExito = (Model.SuccessMessage ?? string.Empty).Replace("'", "\'");
    var msgError = (Model.ErrorMessage ?? string.Empty).Replace("'", "\'");
}

<style>
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .tabla {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .tabla th {
            background-color: var(--content-bg);
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
        }

        .tabla td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .tabla tr:hover {
            background-color: var(--content-bg);
        }

    .btn-danger {
        background-color: #ef4444;
        color: white;
    }

        .btn-danger:hover {
            background-color: #dc2626;
        }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .alert-success {
        background-color: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-error {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* ── Paginación ─────────────────────────────────── */
    .paginacion {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--border-color);
        font-size: 14px;
        color: var(--text-secondary);
    }

    .paginacion-nums {
        display: flex;
        gap: 4px;
        align-items: center;
    }
        /* Botones de número de página */
        .paginacion-nums a.pag-num,
        .paginacion-nums span.pag-num {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: var(--text-primary);
            font-size: 13px;
            text-decoration: none;
            transition: background .15s;
        }

            .paginacion-nums a.pag-num:hover {
                background: var(--content-bg);
            }

            .paginacion-nums span.pag-num.activa {
                background: var(--accent-color, #4f46e5);
                color: #fff;
                border-color: var(--accent-color, #4f46e5);
                font-weight: 600;
            }
        /* Anterior / Siguiente: solo texto, igual a la imagen de referencia */
        .paginacion-nums a.pag-nav {
            color: var(--text-secondary);
            font-size: 13px;
            text-decoration: none;
            padding: 0 4px;
            white-space: nowrap;
            transition: color .15s;
        }

            .paginacion-nums a.pag-nav:hover {
                color: var(--accent-color, #4f46e5);
            }

        .paginacion-nums span.pag-nav-disabled {
            color: #c8c8c8;
            font-size: 13px;
            padding: 0 4px;
            white-space: nowrap;
            cursor: default;
        }

    /* ── Modales ────────────────────────────────────── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(0,0,0,0.5);
        z-index: 2000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal {
        background: white;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-sm {
        max-width: 400px;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .modal-header h3 {
            font-size: 18px;
            font-weight: 600;
            margin: 0;
        }

    .modal-close {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: var(--text-secondary);
        line-height: 1;
    }

    .form-group {
        margin-bottom: 16px;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 6px;
            color: var(--text-primary);
        }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: var(--accent-color);
        }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 20px;
    }

    .pantallas-label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 8px;
        display: block;
    }

    .pantallas-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        max-height: 200px;
        overflow-y: auto;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 8px;
    }

    .pantalla-check {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 7px;
        border-radius: 6px;
        font-size: 13px;
        color: var(--text-primary);
        cursor: pointer;
        transition: background .15s;
    }

        .pantalla-check:hover {
            background: var(--content-bg);
        }

        .pantalla-check input[type="checkbox"] {
            accent-color: var(--accent-color, #4f46e5);
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

    .sin-pantallas {
        font-size: 13px;
        color: var(--text-secondary);
        font-style: italic;
    }
    /* Error dentro del modal */
    .modal-error {
        display: none;
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        margin-bottom: 14px;
    }

        .modal-error.visible {
            display: block;
        }
    /* Spinner en el botón Guardar */
    .btn-saving {
        opacity: 0.7;
        cursor: not-allowed;
    }

    /* El modal de resultado usa .modal-overlay, .modal, .modal-sm ya definidos arriba */
</style>

<div class="page-title">Administración de Roles</div>

@* Los mensajes al usuario se muestran como modal igual al de Áreas de Trabajo *@
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            window.abrirModalResultado('Exito', '@msgExito', false);
        });
    </script>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            window.abrirModalResultado('Error', '@msgError', false);
        });
    </script>
}

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Listado de Roles (@Model.TotalRegistros registros)</h2>
        <button class="btn btn-primary" onclick="abrirModalCrear()">+ Nuevo</button>
    </div>

    <table class="tabla">
        <thead>
            <tr>
                <th>Nombre del Rol</th>
                <th>Pantallas</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Roles.Any())
            {
                foreach (var rol in Model.Roles)
                {
                    var pantallasJson = System.Text.Json.JsonSerializer.Serialize(
                    rol.Pantallas.Select(g => g.ToString()).ToList());
                    <tr>
                        <td>@rol.NombreRol</td>
                        <td>@rol.Pantallas.Count pantalla(s)</td>
                        <td>
                            <button class="btn btn-secondary"
                                    data-id="@rol.RolID"
                                    data-nombre="@rol.NombreRol"
                                    data-pantallas="@pantallasJson"
                                    onclick="abrirModalEditar(this)">
                                ✏️
                            </button>
                            <button class="btn btn-danger"
                                    data-id="@rol.RolID"
                                    data-nombre="@rol.NombreRol"
                                    onclick="confirmarEliminar(this)">
                                🗑️
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" style="text-align:center;color:var(--text-secondary);padding:24px;">
                        No hay roles registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Paginación *@
    @if (Model.TotalPaginas > 1)
    {
        <div class="paginacion">
            <span>Página @Model.PaginaActual de @Model.TotalPaginas (@Model.TotalRegistros registros)</span>
            <div class="paginacion-nums">

                @if (Model.PaginaActual > 1)
                {
                    <a href="?pagina=@(Model.PaginaActual - 1)" class="pag-nav">Anterior</a>
                }
                else
                {
                    <span class="pag-nav-disabled">Anterior</span>
                }

                @{
                    int desde = Math.Max(1, Model.PaginaActual - 3);
                    int hasta = Math.Min(Model.TotalPaginas, desde + 6);
                    desde = Math.Max(1, hasta - 6);
                }
                @for (int i = desde; i <= hasta; i++)
                {
                    if (i == Model.PaginaActual)
                    {
                        <span class="pag-num activa">@i</span>
                    }
                    else
                    {
                        <a href="?pagina=@i" class="pag-num">@i</a>
                    }
                }

                @if (Model.PaginaActual < Model.TotalPaginas)
                {
                    <a href="?pagina=@(Model.PaginaActual + 1)" class="pag-nav">Siguiente</a>
                }
                else
                {
                    <span class="pag-nav-disabled">Siguiente</span>
                }

            </div>
        </div>
    }
    else if (Model.TotalRegistros > 0)
    {
        <div class="paginacion">
            <span>@Model.TotalRegistros registro(s)</span>
        </div>
    }
</div>

@* ── Modal Crear ─────────────────────────────────────────────────────────── *@
<div class="modal-overlay" id="modalCrear">
    <div class="modal">
        <div class="modal-header">
            <h3>Nuevo Rol</h3>
            <button class="modal-close" onclick="cerrarModal('modalCrear')">&#x2715;</button>
        </div>
        @* Error de validación visible DENTRO del modal *@
        <div class="modal-error" id="errorCrear"></div>
        <div class="form-group">
            <label>Nombre del Rol *</label>
            <input type="text" id="crearNombre" class="form-control"
                   maxlength="40" placeholder="Ej: Administrador" />
        </div>
        <div class="form-group">
            <span class="pantallas-label">Pantallas de acceso</span>
            @if (Model.Pantallas.Any())
            {
                <div class="pantallas-grid" id="pantallasCrear">
                    @foreach (var p in Model.Pantallas)
                    {
                        <label class="pantalla-check">
                            <input type="checkbox"
                                   class="crear-pantalla-check"
                                   value="@p.PantallaID" />
                            @p.NombrePantalla
                        </label>
                    }
                </div>
            }
            else
            {
                <p class="sin-pantallas">No hay pantallas disponibles.</p>
            }
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalCrear')">Cancelar</button>
            <button type="button" class="btn btn-primary" id="btnGuardarCrear"
                    onclick="guardarRol('crear')">
                Guardar
            </button>
        </div>
    </div>
</div>

@* ── Modal Editar ────────────────────────────────────────────────────────── *@
<div class="modal-overlay" id="modalEditar">
    <div class="modal">
        <div class="modal-header">
            <h3>Editar Rol</h3>
            <button class="modal-close" onclick="cerrarModal('modalEditar')">&#x2715;</button>
        </div>
        <div class="modal-error" id="errorEditar"></div>
        <div class="form-group">
            <label>Nombre del Rol *</label>
            <input type="text" id="editarNombre" class="form-control"
                   maxlength="40" />
        </div>
        <div class="form-group">
            <span class="pantallas-label">Pantallas de acceso</span>
            @if (Model.Pantallas.Any())
            {
                <div class="pantallas-grid" id="pantallasEditar">
                    @foreach (var p in Model.Pantallas)
                    {
                        <label class="pantalla-check">
                            <input type="checkbox"
                                   class="editar-pantalla-check"
                                   value="@p.PantallaID" />
                            @p.NombrePantalla
                        </label>
                    }
                </div>
            }
            else
            {
                <p class="sin-pantallas">No hay pantallas disponibles.</p>
            }
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalEditar')">Cancelar</button>
            <button type="button" class="btn btn-primary" id="btnGuardarEditar"
                    onclick="guardarRol('editar')">
                Guardar
            </button>
        </div>
    </div>
</div>

@* ── Modal Resultado (Éxito / Error) — igual al modal de Áreas de Trabajo ───── *@
<div class="modal-overlay" id="modalResultado">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 id="modalResultadoTitulo">Éxito</h3>
            <button class="modal-close" onclick="cerrarModalResultado()">&#x2715;</button>
        </div>
        <p id="modalResultadoMsg" style="margin: 8px 0 16px 0;"></p>
        <div class="modal-footer">
            <button class="btn btn-primary" onclick="cerrarModalResultado()">Cerrar</button>
        </div>
    </div>
</div>

@* ── Modal Confirmar Eliminar ─────────────────────────────────────────────── *@
<div class="modal-overlay" id="modalEliminar">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3>Confirmar Eliminación</h3>
            <button class="modal-close" onclick="cerrarModal('modalEliminar')">&#x2715;</button>
        </div>
        <p id="mensajeEliminar" style="font-size:14px;color:var(--text-primary);margin-bottom:0;"></p>
        @* Eliminar sí hace POST normal — no necesita validación *@
        <form method="post" asp-page-handler="Eliminar" asp-route-pagina="@paginaActual">
            @Html.AntiForgeryToken()
            <input type="hidden" name="rolId" id="eliminarRolId" />
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalEliminar')">No</button>
                <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {

        // ── Helpers de modal ─────────────────────────────────────────────────────

        window.cerrarModal = function(id) {
            document.getElementById(id).classList.remove('active');
        };

        // ── Modal resultado Éxito/Error — globales para acceso desde HTML y Razor ──
        var _recargarAlCerrar = false;

        window.abrirModalResultado = function(titulo, mensaje, recargar) {
            _recargarAlCerrar = !!recargar;
            document.getElementById('modalResultadoTitulo').textContent = titulo;
            document.getElementById('modalResultadoMsg').textContent    = mensaje;
            document.getElementById('modalResultado').classList.add('active');
        };

        window.cerrarModalResultado = function() {
            document.getElementById('modalResultado').classList.remove('active');
            if (_recargarAlCerrar) {
                _recargarAlCerrar = false;
                window.location.reload();
            }
        };

        function mostrarErrorModal(modalErrorId, texto) {
            var el = document.getElementById(modalErrorId);
            el.textContent = texto;
            el.classList.add('visible');
        }

        function ocultarErrorModal(modalErrorId) {
            var el = document.getElementById(modalErrorId);
            el.textContent = '';
            el.classList.remove('visible');
        }

        // ── Abrir modales ────────────────────────────────────────────────────────

        window.abrirModalCrear = function() {
            ocultarErrorModal('errorCrear');
            document.getElementById('crearNombre').value = '';
            document.querySelectorAll('.crear-pantalla-check')
                .forEach(function(cb) { cb.checked = false; });
            document.getElementById('modalCrear').classList.add('active');
        };

        window.abrirModalEditar = function(btn) {
            ocultarErrorModal('errorEditar');
            document.getElementById('editarNombre').value = btn.dataset.nombre;

            // Guardar el ID del rol que se edita en el botón de guardar
            document.getElementById('btnGuardarEditar').dataset.rolId = btn.dataset.id;

            // Marcar las pantallas del rol
            var pantallas = JSON.parse(btn.dataset.pantallas);
            document.querySelectorAll('.editar-pantalla-check').forEach(function(cb) {
                cb.checked = pantallas.indexOf(cb.value) !== -1;
            });

            document.getElementById('modalEditar').classList.add('active');
        };

        window.confirmarEliminar = function(btn) {
            document.getElementById('eliminarRolId').value = btn.dataset.id;
            document.getElementById('mensajeEliminar').textContent =
                '\u00bfRealmente desea eliminar el rol "' + btn.dataset.nombre + '"?';
            document.getElementById('modalEliminar').classList.add('active');
        };

        // ── Validación en cliente (dentro del modal, sin ir al servidor) ─────────

        function validarNombreModal(nombre, errorId) {
            if (!nombre) {
                mostrarErrorModal(errorId, 'El nombre del rol es obligatorio.');
                return false;
            }
            if (nombre.length > 40) {
                mostrarErrorModal(errorId, 'El nombre no puede superar 40 caracteres.');
                return false;
            }
            if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]+$/.test(nombre)) {
                mostrarErrorModal(errorId, 'El nombre solo puede contener letras y espacios.');
                return false;
            }
            return true;
        }

        // ── Guardar rol vía fetch (POST al handler del servidor) ─────────────────
        // Se usa fetch para:
        //   1. Validar en cliente primero — el error aparece dentro del modal.
        //   2. Si el servidor también devuelve error — mostrarlo en el modal.
        //   3. Si es exitoso — recargar la página para reflejar el cambio.

        window.guardarRol = function(modo) {
            var esCrear   = (modo === 'crear');
            var errorId   = esCrear ? 'errorCrear'  : 'errorEditar';
            var btnId     = esCrear ? 'btnGuardarCrear' : 'btnGuardarEditar';
            var nombre    = (esCrear
                ? document.getElementById('crearNombre')
                : document.getElementById('editarNombre')).value.trim();

            ocultarErrorModal(errorId);

            // Validar nombre en cliente
            if (!validarNombreModal(nombre, errorId)) return;

            // Recoger pantallas seleccionadas
            var selector   = esCrear ? '.crear-pantalla-check' : '.editar-pantalla-check';
            var pantallas  = Array.from(document.querySelectorAll(selector + ':checked'))
                                 .map(function(cb) { return cb.value; });

            if (pantallas.length === 0) {
                mostrarErrorModal(errorId, 'Debe seleccionar al menos una pantalla para el rol.');
                return;
            }

            // Construir FormData para el handler de Razor Pages
            var form  = new FormData();
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) form.append('__RequestVerificationToken', token.value);
            form.append('NombreRol', nombre);
            pantallas.forEach(function(g) { form.append('PantallasSeleccionadas', g); });

            if (!esCrear) {
                var rolId = document.getElementById('btnGuardarEditar').dataset.rolId;
                form.append('RolID', rolId);
            }

            // Bloquear botón mientras procesa
            var btn = document.getElementById(btnId);
            btn.disabled    = true;
            btn.textContent = 'Guardando...';
            btn.classList.add('btn-saving');

            var handler = esCrear ? '?handler=Crear' : '?handler=Editar';
            // Preservar la página actual en la URL
            var pagina  = new URLSearchParams(window.location.search).get('pagina') || '1';

            fetch(window.location.pathname + handler + '&pagina=' + pagina, {
                method: 'POST',
                body:   form
            })
            .then(function(response) {
                // Razor Pages redirige con 302 tras éxito — fetch sigue el redirect.
                // Si la respuesta final es OK (200), el servidor procesó exitosamente.
                if (response.ok) {
                    cerrarModal(esCrear ? 'modalCrear' : 'modalEditar');
                    // recargar=true: al pulsar Cerrar se recarga la página automáticamente
                    window.abrirModalResultado(
                        'Éxito',
                        esCrear ? 'Rol creado exitosamente.' : 'Rol actualizado exitosamente.',
                        true
                    );
                } else {
                    // El servidor devolvió un error (4xx/5xx) — mostrar en el modal
                    return response.text().then(function(text) {
                        // Intentar extraer el mensaje de error de la respuesta
                        var match = text.match(/class="alert alert-error"[^>]*>([^<]+)</);
                        var msg   = match
                            ? match[1].trim()
                            : 'No se pudo guardar el rol. Intente de nuevo.';
                        mostrarErrorModal(errorId, msg);
                    });
                }
            })
            .catch(function() {
                mostrarErrorModal(errorId, 'Error de conexión. Intente de nuevo.');
            })
            .finally(function() {
                btn.disabled    = false;
                btn.textContent = 'Guardar';
                btn.classList.remove('btn-saving');
            });
        };

        // ── Cerrar modal al hacer clic en el fondo oscuro ───────────────────────
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.modal-overlay').forEach(function(overlay) {
                overlay.addEventListener('click', function(e) {
                    if (e.target === overlay) overlay.classList.remove('active');
                });
            });
        });

    }());
</script>

