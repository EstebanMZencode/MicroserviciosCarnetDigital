@page
@model SitioAdministrativoCarnetDigital.Pages.ModuloRoles.RolesModel
@{
    ViewData["Title"] = "Roles";
    Layout = "_Layout";
}

@section Styles {
    @* CSS propio del módulo — ubicado en la misma carpeta ModuloRoles *@
    <style>
           
.page-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
}

.page-header-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #5c6bc0;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.page-header h1 {
    font-size: 1.45rem;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 2px;
    line-height: 1.2;
}

.page-header p {
    font-size: 0.82rem;
    color: #6b7280;
    margin: 0;
}

/* ── Tarjeta contenedora ─────────────────────────────────────── */
.r-card {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 14px rgba(0,0,0,.05);
    overflow: hidden;
}

/* Cabecera de la tarjeta: título izquierda, acción derecha */
.r-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
}

.r-card-title {
    font-size: .95rem;
    font-weight: 600;
    color: #374151;
}

/* ── Botón "+ Nuevo" ──────────────────────────────────────────── */
.btn-nuevo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #5c6bc0;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 9px 18px;
    font-size: .875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background .15s;
}

    .btn-nuevo:hover {
        background: #4f5ba8;
        color: #fff;
    }

/* ── Tabla de roles ───────────────────────────────────────────── */
.r-table {
    width: 100%;
    border-collapse: collapse;
}

    .r-table thead tr {
        border-bottom: 1px solid #e5e7eb;
    }

    .r-table th {
        padding: 11px 24px;
        font-size: .72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #9ca3af;
        text-align: left;
    }

    .r-table td {
        padding: 14px 24px;
        font-size: .88rem;
        color: #374151;
        border-bottom: 1px solid #f3f4f6;
        vertical-align: middle;
    }

    .r-table tbody tr:last-child td {
        border-bottom: none;
    }

    .r-table tbody tr:hover {
        background: #fafafa;
    }

/* Celda de acciones alineada a la derecha */
.r-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
}

/* Botones icono (lápiz / basurero) */
.btn-ico {
    background: none;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 7px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    transition: border-color .15s, background .15s;
}

    .btn-ico:hover {
        border-color: #e5e7eb;
        background: #f9fafb;
    }

.btn-ico-edit {
    color: #f59e0b; /* Naranja */
    background: transparent;
    border: none;
}

.btn-ico-edit:hover {
    color: #d97706; /* Naranja más oscuro */
}

.btn-ico-delete {
    background: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 6px;
}

.btn-ico-delete:hover {
    background: #b91c1c;
}

/* ── Paginación ───────────────────────────────────────────────── */
.r-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    border-top: 1px solid #f3f4f6;
}

.r-pagination-info {
    font-size: .82rem;
    color: #6b7280;
}

.r-pagination-nums {
    display: flex;
    gap: 4px;
}

.btn-pag {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid #e5e7eb;
    background: #fff;
    color: #374151;
    font-size: .82rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background .15s;
}

    .btn-pag:hover {
        background: #f3f4f6;
    }

    .btn-pag.pag-active {
        background: #5c6bc0;
        color: #fff;
        border-color: #5c6bc0;
    }

/* ── Etiquetas inline éxito / error ──────────────────────────── */
/* Estos estilos replican exactamente los de las capturas: fondo   */
/* salmón para error y verde-oliva para éxito, icono a la izq.    */
.alert {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 16px;
    border-radius: 8px;
    margin-bottom: 18px;
    font-size: .875rem;
    font-weight: 500;
    line-height: 1.4;
}

    .alert svg {
        flex-shrink: 0;
    }

.alert-error {
    background: #d9614f;
    color: #fff;
}

.alert-success {
    background: #7ba428;
    color: #fff;
}

/* ── Barra de acciones de formulario ─────────────────────────── */
.form-actions-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
}

.btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    color: #374151;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 9px 16px;
    font-size: .875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: background .15s;
}

    .btn-back:hover {
        background: #f9fafb;
        color: #374151;
    }

.btn-save {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #5c6bc0;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 9px 20px;
    font-size: .875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background .15s;
}

    .btn-save:hover {
        background: #4f5ba8;
    }

    .btn-save:disabled {
        background: #b0b8e0;
        cursor: not-allowed;
    }

/* ── Sección de formulario ────────────────────────────────────── */
.form-section {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 1px 3px rgba(0,0,0,.06);
    padding: 24px;
    margin-bottom: 16px;
}

.form-section-title {
    font-size: .95rem;
    font-weight: 600;
    color: #374151;
    margin: 0 0 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f3f4f6;
}

.form-group {
    margin-bottom: 18px;
}

.form-label {
    display: block;
    font-size: .875rem;
    font-weight: 500;
    color: #374151;
    margin-bottom: 6px;
}

.req {
    color: #ef4444;
}

.form-control {
    width: 100%;
    padding: 9px 13px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-size: .9rem;
    color: #1f2937;
    background: #fff;
    box-sizing: border-box;
    transition: border-color .15s, box-shadow .15s;
}

    .form-control:focus {
        outline: none;
        border-color: #5c6bc0;
        box-shadow: 0 0 0 3px rgba(92,107,192,.12);
    }

    .form-control[readonly] {
        background: #f9fafb;
        color: #9ca3af;
        cursor: default;
    }

/* ── Checklist de pantallas ───────────────────────────────────── */
.pantallas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
}

.pantalla-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    cursor: pointer;
    transition: border-color .15s, background .15s;
    user-select: none;
}

    .pantalla-item:hover {
        border-color: #5c6bc0;
        background: #f5f6ff;
    }

    .pantalla-item.is-checked {
        border-color: #5c6bc0;
        background: #eef0fb;
    }

    .pantalla-item input[type="checkbox"] {
        accent-color: #5c6bc0;
        width: 16px;
        height: 16px;
        cursor: pointer;
        flex-shrink: 0;
    }

    .pantalla-item label {
        font-size: .875rem;
        color: #374151;
        cursor: pointer;
        line-height: 1.4;
    }

.empty-pantallas {
    font-size: .875rem;
    color: #9ca3af;
    font-style: italic;
}

/* ── Overlays / Modales ───────────────────────────────────────── */
/* Fondo semitransparente que cubre toda la ventana */
.modal-bg {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.42);
    z-index: 9990;
    align-items: center;
    justify-content: center;
}

    .modal-bg.show {
        display: flex;
    }

/* Tarjeta blanca del modal */
.modal-box {
    background: #fff;
    border-radius: 16px;
    padding: 36px 32px;
    max-width: 430px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,.18);
    animation: popIn .18s ease;
}

/* Círculo de ícono */
.modal-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
}

.modal-icon-warn {
    background: #fef3c7;
    color: #f59e0b;
}

.modal-icon-success {
    background: #dcfce7;
    color: #22c55e;
}

.modal-icon-error {
    background: #fee2e2;
    color: #ef4444;
}

/* Textos del modal */
.modal-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a2744;
    margin-bottom: 10px;
}

.modal-msg {
    font-size: .88rem;
    color: #6b7280;
    line-height: 1.55;
    margin-bottom: 28px;
}

/* Fila de botones */
.modal-btns {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
}

.btn-modal-cancel {
    padding: 10px 24px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    color: #374151;
    font-size: .875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background .15s;
}

    .btn-modal-cancel:hover {
        background: #f9fafb;
    }

/* Botón rojo de confirmación de borrado */
.btn-modal-danger {
    padding: 10px 24px;
    border: none;
    border-radius: 8px;
    background: #ef4444;
    color: #fff;
    font-size: .875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background .15s;
}

    .btn-modal-danger:hover {
        background: #dc2626;
    }

/* Botón de cierre genérico (gris) */
.btn-modal-close {
    padding: 10px 28px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: #6b7280;
    color: #fff;
    font-size: .875rem;
    font-weight: 500;
    cursor: pointer;
}

    </style>
}

@* ── Cabecera de página ─────────────────────────────────────── *@
<div class="page-header">
    <div class="page-header-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
    </div>
    <div>
        <h1>Roles</h1>
        <p>Administración de roles del sistema</p>
    </div>
</div>

@* ── Etiqueta de éxito ──────────────────────────────────────── *@
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="alert">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" />
        </svg>
        @Model.SuccessMessage
    </div>
}

@* ── Etiqueta de error ──────────────────────────────────────── *@
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd"
                  d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" />
        </svg>
        @Model.ErrorMessage
    </div>
}

@* ── Tarjeta con tabla de roles ─────────────────────────────── *@
<div class="r-card">

    @* Encabezado: conteo + botón Nuevo *@
    <div class="r-card-header">
        <span class="r-card-title">Listado (@Model.TotalRegistros registros)</span>
        <a asp-page="Create" class="btn-nuevo">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Nuevo
        </a>
    </div>

    @* Tabla *@
    <table class="r-table">
        <thead>
            <tr>
                <th>Nombre del Rol</th>
                <th style="text-align:right; padding-right:30px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Roles.Any())
            {
                foreach (var rol in Model.Roles)
                {
                    <tr>
                        <td>@rol.NombreRol</td>
                        <td>
                            <div class="r-actions">
                                @* Botón editar: navega a Edit con el ID en el query string *@
                                <a asp-page="Edit" asp-route-id="@rol.RolID"
                                   class="btn-ico btn-ico-edit" title="Editar">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                    </svg>
                                </a>
                                @* Botón eliminar: abre modal de confirmación *@
                                <button type="button" class="btn-ico btn-ico-delete" title="Eliminar"
                                        onclick="showDeleteModal('@rol.RolID','@Html.Raw(Html.Encode(rol.NombreRol))')">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                        <path d="M10 11v6M14 11v6" />
                                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2"
                        style="text-align:center; color:#9ca3af; padding:40px 24px; font-size:.875rem;">
                        No hay roles registrados aún.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Paginación *@
    <div class="r-pagination">
        <span class="r-pagination-info">
            Página @Model.PaginaActual de @Model.TotalPaginas
        </span>
        <div class="r-pagination-nums">
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <a href="?pagina=@i"
                   class="btn-pag @(i == Model.PaginaActual ? "pag-active" : "")">@i</a>
            }
        </div>
    </div>
</div>

@* ── Formulario oculto para el soft-delete ──────────────────── *@
@* Se envía cuando el usuario confirma en el modal de advertencia *@
<form id="formDelete" method="post" asp-page-handler="Delete" style="display:none;">
    <input type="hidden" id="inputDeleteId" name="rolId" />
</form>

@* ── Modal de advertencia: confirmar eliminación ──────────────── *@
<div class="modal-bg" id="modalDelete" role="dialog" aria-modal="true">
    <div class="modal-box">
        <div class="modal-icon modal-icon-warn">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </div>
        <div class="modal-title">Eliminar Rol</div>
        <div class="modal-msg">
            ¿Está seguro que desea eliminar el rol
            <strong id="delRolNombre"></strong>?<br>
            Esta acción no se puede revertir.
        </div>
        <div class="modal-btns">
            <button type="button" class="btn-modal-cancel" onclick="hideDeleteModal()">
                No, cancelar
            </button>
            <button type="button" class="btn-modal-danger" onclick="confirmDelete()">
                Sí, eliminar
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                // ============================================================
        // ModuloRoles — lógica JavaScript
        // ============================================================

        // ── Modal de confirmación de eliminación ─────────────────────
        let _rolIdPendiente = null;

        // Abre el modal de advertencia y guarda el ID a eliminar.
        function showDeleteModal(rolId, rolNombre) {
            _rolIdPendiente = rolId;
            const span = document.getElementById('delRolNombre');
            if (span) span.textContent = rolNombre;
            document.getElementById('modalDelete').classList.add('show');
        }

        // Cierra el modal de advertencia sin hacer nada.
        function hideDeleteModal() {
            document.getElementById('modalDelete').classList.remove('show');
            _rolIdPendiente = null;
        }

        // Transfiere el ID al input oculto y envía el formulario de borrado.
        function confirmDelete() {
            if (!_rolIdPendiente) return;
            document.getElementById('inputDeleteId').value = _rolIdPendiente;
            document.getElementById('formDelete').submit();
        }

        // ── Modal genérico éxito / error ────────────────────────────
        // Se llama desde código C# si se requiere mostrar un modal
        // en lugar de la etiqueta inline.
        function showResultModal(type, title, message) {
            const overlay = document.getElementById('modalResult');
            if (!overlay) return;

            // Aplica la clase de color al ícono
            const icon = document.getElementById('resultIcon');
            icon.className = 'modal-icon modal-icon-' + type; // 'success' | 'error'

            document.getElementById('resultTitle').textContent = title;
            document.getElementById('resultMsg').textContent = message;
            overlay.classList.add('show');
        }

        function hideResultModal() {
            const overlay = document.getElementById('modalResult');
            if (overlay) overlay.classList.remove('show');
        }

        // ── Validación en tiempo real de NombreRol ───────────────────
        // Elimina cualquier carácter que no sea letra (incluyendo
        // español: ñ, tildes) o espacio mientras el usuario escribe.
        function validarNombreRol(input) {
            const permitidos = /^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]*$/;
            if (!permitidos.test(input.value)) {
                input.value = input.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, '');
            }
        }

        // ── Checklist de pantallas ───────────────────────────────────
        // Añade o quita la clase visual "is-checked" al hacer clic.
        function togglePantalla(checkbox) {
            const item = checkbox.closest('.pantalla-item');
            if (item) item.classList.toggle('is-checked', checkbox.checked);
        }

        // ── Inicialización ───────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {

            // En la página Edit, marcar visualmente los checks que ya vienen activos.
            document.querySelectorAll('.pantalla-item input[type="checkbox"]').forEach(cb => {
                if (cb.checked) {
                    cb.closest('.pantalla-item')?.classList.add('is-checked');
                }
            });

            // Cerrar cualquier modal al hacer clic en el fondo oscuro (fuera de la caja).
            document.querySelectorAll('.modal-bg').forEach(overlay => {
                overlay.addEventListener('click', e => {
                    if (e.target === overlay) overlay.classList.remove('show');
                });
            });
        });
    </script>
}
