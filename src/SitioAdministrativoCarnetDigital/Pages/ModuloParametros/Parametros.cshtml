@page
@model SitioAdministrativoCarnetDigital.Pages.ModuloParametros.ParametrosModel
@{
    ViewData["Title"] = "Parámetros";
    ViewData["Section"] = "Administración de Parámetros";
}

<style>
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .card-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .tabla {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .tabla th {
            background-color: var(--content-bg);
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
        }

        .tabla td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .tabla tr:hover {
            background-color: var(--content-bg);
        }

    .btn-danger {
        background-color: #ef4444;
        color: white;
    }

        .btn-danger:hover {
            background-color: #dc2626;
        }

    .alert-box {
        display: none;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .alert-exito {
        background-color: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-error {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(0,0,0,0.5);
        z-index: 2000;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal {
        background: white;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }

    .modal-sm {
        max-width: 380px;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .modal-header h3 {
            font-size: 18px;
            font-weight: 600;
        }

    .modal-close {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: var(--text-secondary);
    }

    .form-group {
        margin-bottom: 16px;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 6px;
            color: var(--text-primary);
        }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 14px;
        outline: none;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 20px;
    }
</style>

<form id="antiforgeryForm">@Html.AntiForgeryToken()</form>

<div class="page-title">Administración de Parámetros</div>
<div id="alertBox" class="alert-box"></div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert-box alert-error" style="display:block">@Model.MensajeError</div>
}

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Listado de Parámetros</h2>
        <button class="btn btn-primary" id="btnNuevo">+ Nuevo</button>
    </div>

    <table class="tabla">
        <thead>
            <tr>
                <th>Identificador</th>
                <th>Valor</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="tablaBody">
            @foreach (var p in Model.Parametros)
            {
                <tr data-id="@p.Identificador" data-valor="@p.Valor">
                    <td>@p.Identificador</td>
                    <td>@p.Valor</td>
                    <td>@(p.Estado ? "Activo" : "Inactivo")</td>
                    <td>
                        <button class="btn btn-secondary btn-editar">✏️</button>
                        <button class="btn btn-danger btn-eliminar">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Crear/Editar -->
<div class="modal-overlay" id="modalParametro">
    <div class="modal">
        <div class="modal-header">
            <h3 id="modalTitulo">Nuevo Parámetro</h3>
            <button class="modal-close" onclick="cerrarModal()">✕</button>
        </div>
        <input type="hidden" id="inputId" />
        <div class="form-group">
            <label>Identificador <small>(solo letras mayúsculas, máx 10)</small></label>
            <input type="text" id="inputIdentificador" class="form-control" maxlength="10" />
        </div>
        <div class="form-group">
            <label>Valor <small>(máx 500 caracteres)</small></label>
            <textarea id="inputValor" class="form-control" maxlength="500" rows="3"></textarea>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="cerrarModal()">Cancelar</button>
            <button class="btn btn-primary" id="btnGuardar">Guardar</button>
        </div>
    </div>
</div>

<!-- Modal Confirmar Eliminar -->
<div class="modal-overlay" id="modalEliminar">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3>Confirmar Eliminación</h3>
            <button class="modal-close" onclick="cerrarModalEliminar()">✕</button>
        </div>
        <p>¿Realmente desea eliminar el elemento seleccionado?</p>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="cerrarModalEliminar()">No</button>
            <button class="btn btn-danger" id="btnSiEliminar">Sí, eliminar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let idAEliminar = null;

        function mostrarAlerta(mensaje, tipo) {
            const box = document.getElementById('alertBox');
            box.className = 'alert-box ' + (tipo === 'exito' ? 'alert-exito' : 'alert-error');
            box.style.display = 'block';
            box.textContent = mensaje;
            setTimeout(() => box.style.display = 'none', 6000);
        }

        document.getElementById('btnNuevo').addEventListener('click', () => {
            document.getElementById('modalTitulo').textContent = 'Nuevo Parámetro';
            document.getElementById('inputIdentificador').value = '';
            document.getElementById('inputIdentificador').readOnly = false;
            document.getElementById('inputValor').value = '';
            document.getElementById('modalParametro').classList.add('active');
        });

        document.querySelectorAll('.btn-editar').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const fila = e.target.closest('tr');
                document.getElementById('modalTitulo').textContent = 'Editar Parámetro';
                document.getElementById('inputIdentificador').value = fila.dataset.id;
                document.getElementById('inputIdentificador').readOnly = true;
                document.getElementById('inputValor').value = fila.dataset.valor;
                document.getElementById('modalParametro').classList.add('active');
            });
        });

        document.querySelectorAll('.btn-eliminar').forEach(btn => {
            btn.addEventListener('click', (e) => {
                idAEliminar = e.target.closest('tr').dataset.id;
                document.getElementById('modalEliminar').classList.add('active');
            });
        });

        function cerrarModal() { document.getElementById('modalParametro').classList.remove('active'); }
        function cerrarModalEliminar() { document.getElementById('modalEliminar').classList.remove('active'); idAEliminar = null; }

        document.getElementById('btnGuardar').addEventListener('click', async () => {
            const body = {
                identificador: document.getElementById('inputIdentificador').value.trim(),
                valor: document.getElementById('inputValor').value.trim()
            };
            const resp = await fetch('?handler=Guardar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(body)
            });
            const data = await resp.json();
            cerrarModal();
            mostrarAlerta(data.mensaje, data.exito ? 'exito' : 'error');
            if (data.exito) setTimeout(() => location.reload(), 1500);
        });

        document.getElementById('btnSiEliminar').addEventListener('click', async () => {
            const resp = await fetch('?handler=Eliminar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(idAEliminar)
            });
            const data = await resp.json();
            cerrarModalEliminar();
            mostrarAlerta(data.mensaje, data.exito ? 'exito' : 'error');
            if (data.exito) setTimeout(() => location.reload(), 1500);
        });
    </script>
}