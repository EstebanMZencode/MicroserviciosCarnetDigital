@page
@model SitioAdministrativoCarnetDigital.Pages.ModuloParametros.ParametrosModel
@{
    ViewData["Title"] = "Parámetros";
    ViewData["Section"] = "Parámetros";
}

@if (Model.Mensaje != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Administración de Parámetros</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalParametro" onclick="limpiarForm()">
        + Nuevo Parámetro
    </button>
</div>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar...">
    <button class="btn btn-secondary" type="submit">Buscar</button>
</form>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Identificador</th>
            <th>Valor</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Parametros)
        {
            <tr>
                <td>@p.Identificador</td>
                <td>@p.Valor</td>
                <td>@(p.Estado ? "Activo" : "Inactivo")</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-secondary"
                            onclick="cargarEditar('@p.Identificador','@p.Valor')"
                            data-bs-toggle="modal" data-bs-target="#modalParametro">
                        Editar
                    </button>
                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@p.Identificador" class="d-inline"
                          onsubmit="return confirm('¿Realmente desea eliminar el elemento seleccionado?')">
                        <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPaginas; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" asp-page="/ModuloParametros/Parametros" asp-route-page="@i" asp-route-busqueda="@Model.Busqueda">@i</a>
            </li>
        }
    </ul>
</nav>

<!-- Modal -->
<div class="modal fade" id="modalParametro" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitulo">Nuevo Parámetro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="formParametro">
                <div class="modal-body">
                    <input type="hidden" asp-for="EsEdicion" id="esEdicion" value="false" />
                    <div class="mb-3">
                        <label class="form-label">Identificador <small class="text-muted">(solo letras mayúsculas, máx 10)</small></label>
                        <input asp-for="Form.Identificador" class="form-control" id="formId" required maxlength="10" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Valor <small class="text-muted">(máx 500 caracteres)</small></label>
                        <textarea asp-for="Form.Valor" class="form-control" id="formValor" required maxlength="500" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function limpiarForm() {
            document.getElementById('modalTitulo').innerText = 'Nuevo Parámetro';
            document.getElementById('formParametro').action = '?handler=Crear';
            document.getElementById('formId').value = '';
            document.getElementById('formId').readOnly = false;
            document.getElementById('formValor').value = '';
        }
        function cargarEditar(id, valor) {
            document.getElementById('modalTitulo').innerText = 'Editar Parámetro';
            document.getElementById('formParametro').action = '?handler=Editar';
            document.getElementById('formId').value = id;
            document.getElementById('formId').readOnly = true;
            document.getElementById('formValor').value = valor;
        }
    </script>
}