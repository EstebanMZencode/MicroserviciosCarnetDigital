@page
@model SitioAdministrativoCarnetDigital.Pages.ModuloAuth.LoginModel
@{
    @* Sin Layout: esta página ocupa toda la pantalla con su propio fondo. *@
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Iniciar sesión — Carnet Digital CUC</title>

    @* CSS en wwwroot/ModuloAuth/Login.css *@
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        /* Fondo: gradiente azul profundo igual al de la captura */
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0d1b6e 0%, #1a237e 30%, #3949ab 70%, #283593 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            padding: 16px;
        }

        /* ── Tarjeta central ─────────────────────────────────────────── */
        .login-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 24px 64px rgba(0, 0, 0, 0.28);
            padding: 44px 40px 36px;
            width: 100%;
            max-width: 430px;
            /* Animación sutil de entrada */
            animation: cardIn .25s ease;
        }
        /* ── Marca / Identidad ───────────────────────────────────────── */
        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
            justify-content: center;
            margin-bottom: 32px;
        }

        /* Ícono cuadrado con bordes redondeados, reemplaza el "CD" de la captura */
        .brand-logo {
            width: 54px;
            height: 54px;
            background: #1a237e;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(26, 35, 126, 0.35);
        }

        .brand-text h1 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #1a237e;
            line-height: 1.2;
            margin: 0;
        }

        .brand-text small {
            font-size: 0.76rem;
            color: #6b7280;
            display: block;
            margin-top: 1px;
        }

        /* ── Mensaje de error / advertencia ─────────────────────────── */
        /* Oculto por defecto; JS / Razor lo muestra con la clase .show */
        .form-alert {
            display: none;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            font-size: 0.84rem;
            line-height: 1.45;
            padding: 11px 14px;
            border-radius: 8px;
            margin-bottom: 18px;
            text-align: center;
        }

            .form-alert.show {
                display: block;
            }

        /* ── Grupos de campo ─────────────────────────────────────────── */
        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            color: #374151;
            margin-bottom: 6px;
        }

        /* font-size 16px: evita el zoom automático en Safari/iOS */
        .form-input {
            width: 100%;
            padding: 12px 14px;
            font-size: 16px;
            color: #111827;
            background: #ffffff;
            border: 1.5px solid #e5e7eb;
            border-radius: 10px;
            transition: border-color .15s, box-shadow .15s;
            -webkit-appearance: none;
            appearance: none;
        }

            .form-input::placeholder {
                color: #9ca3af;
            }

            .form-input:focus {
                outline: none;
                border-color: #3f51b5;
                box-shadow: 0 0 0 3px rgba(63, 81, 181, 0.13);
            }

        /* ── Botón principal ─────────────────────────────────────────── */
        .btn-submit {
            display: block;
            width: 100%;
            padding: 13px;
            margin-top: 8px;
            background: #3f51b5;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: .01em;
            cursor: pointer;
            transition: background .15s, transform .1s, opacity .15s;
        }

            .btn-submit:hover {
                background: #3449a0;
            }

            .btn-submit:active {
                transform: scale(.985);
            }

            .btn-submit:disabled {
                opacity: .65;
                cursor: not-allowed;
            }

        /* ── Enlace de registro ──────────────────────────────────────── */
        .register-row {
            text-align: center;
            margin-top: 20px;
            font-size: 0.875rem;
            color: #6b7280;
        }

            .register-row a {
                color: #3f51b5;
                font-weight: 600;
                text-decoration: none;
            }

                .register-row a:hover {
                    text-decoration: underline;
                }

        /* ── Caja de demo ────────────────────────────────────────────── */
        .demo-box {
            margin-top: 18px;
            background: #f3f4f8;
            border-radius: 10px;
            padding: 10px 16px;
            font-size: 0.78rem;
            color: #6b7280;
            text-align: center;
            line-height: 1.6;
        }

            .demo-box strong {
                color: #374151;
            }

     </style>
</head>
<body>

    <div class="login-card">

        @* ── Marca ──────────────────────────────────────────────── *@
        <div class="brand">
            <div class="brand-logo">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <circle cx="9" cy="10" r="2" />
                    <path d="M15 8h2" />
                    <path d="M15 12h2" />
                    <path d="M7 15h10" />
                </svg>
            </div>
            <div class="brand-text">
                <h1>Carnet Digital</h1>
                <small>Colegio Universitario de Cartago</small>
            </div>
        </div>

        @* ── Mensaje de alerta (error / redirección por sesión) ──── *@
        <div id="formAlert"
             class="form-alert @(!string.IsNullOrEmpty(Model.AlertMessage) ? "show" : "")">
            @Model.AlertMessage
        </div>

        @* ── Formulario ──────────────────────────────────────────── *@
        <form id="loginForm" method="post" autocomplete="on" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="inputUsuario">
                    Usuario (email institucional)
                </label>
                <input type="email"
                       id="inputUsuario"
                       asp-for="Usuario"
                       class="form-input"
                       placeholder="admin@cuc.ac.cr"
                       autocomplete="username"
                       spellcheck="false"
                       inputmode="email" />
            </div>

            <div class="form-group">
                <label class="form-label" for="inputContrasena">Contraseña</label>
                <input type="password"
                       id="inputContrasena"
                       asp-for="Contrasena"
                       class="form-input"
                       placeholder="••••••••"
                       autocomplete="current-password" />
            </div>

            <button type="submit" id="btnSubmit" class="btn-submit">
                Aceptar
            </button>
        </form>

        @* ── Enlace de registro ──────────────────────────────────── *@
        <p class="register-row">
            ¿No tiene cuenta?
            <a href="/ModuloAutoregistro/Autoregistro">Regístrese aquí</a>
        </p>

        @* ── Caja de demo ────────────────────────────────────────── *@
        <div class="demo-box">
            Demo: <strong>admin@cuc.ac.cr / Admin123</strong><br>
            (3 intentos fallidos bloquean el acceso)
        </div>
    </div>

    @* ── Script ──────────────────────────────────────────────────── *@
    <script>
                document.addEventListener('DOMContentLoaded', () => {

            const form = document.getElementById('loginForm');
            const btn = document.getElementById('btnSubmit');
            const user = document.getElementById('inputUsuario');
            const pass = document.getElementById('inputContrasena');

            if (!form) return;

            form.addEventListener('submit', (e) => {
                // Validación mínima en cliente: ambos campos requeridos.
                // El servidor hace la misma validación; esto evita un round-trip innecesario.
                if (!user.value.trim() || !pass.value.trim()) {
                    e.preventDefault();
                    showAlert('Usuario y/o contraseña incorrectos.');
                    return;
                }

                // Deshabilitar botón mientras el servidor procesa la solicitud.
                btn.disabled = true;
                btn.textContent = 'Verificando...';
            });

            // Re-habilitar el botón si el usuario modifica los campos tras un error.
            [user, pass].forEach(el =>
                el.addEventListener('input', () => {
                    if (btn.disabled) {
                        btn.disabled = false;
                        btn.textContent = 'Aceptar';
                    }
                })
            );
        });

        // Muestra el mensaje de error en el bloque .form-alert.
        function showAlert(msg) {
            const el = document.getElementById('formAlert');
            if (!el) return;
            el.textContent = msg;
            el.classList.add('show');
        }

        // Persiste en localStorage todos los datos que devuelve el endpoint /login.
        // Se llama desde el markup Razor justo después de un login exitoso,
        // antes de redirigir, para que cualquier código JS del sitio pueda acceder
        // al email, tipo de usuario, fechas, etc. del usuario autenticado.
        function storeLoginData(data) {
            try {
                localStorage.setItem('loginData', JSON.stringify(data));
            } catch (err) {
                // localStorage puede no estar disponible (modo incógnito sin cuota, etc.)
                console.warn('No se pudo guardar en localStorage:', err);
            }
        }

    </script>

    @* Bloque de login exitoso: se ejecuta solo cuando el servidor autenticó correctamente.
       1. Guarda la respuesta completa en localStorage (email, tokens, expiración).
       2. Redirige al Index. Separamos estas dos acciones del redirect de C# porque
          localStorage no es accesible desde el servidor. *@
    @if (Model.LoginDataJson != null)
    {
        <script>
            storeLoginData(@Html.Raw(Model.LoginDataJson));
            window.location.replace('/');
        </script>
    }

</body>
</html>
