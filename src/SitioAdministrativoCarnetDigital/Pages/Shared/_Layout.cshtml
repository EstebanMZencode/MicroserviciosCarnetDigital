<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Carnet Digital CUC</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-logo">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                        <circle cx="9" cy="10" r="2"></circle>
                        <path d="M15 8h2"></path>
                        <path d="M15 12h2"></path>
                        <path d="M7 15h10"></path>
                    </svg>
                </div>
                <div class="brand-text">
                    <h1>Carnet Digital</h1>
                    <small>Colegio Universitario de Cartago</small>
                </div>
            </div>

            <nav class="sidebar-nav">

                <!-- General -->
                <div class="nav-section">
                    <span class="nav-section-title">General</span>
                    <ul>
                        <li>
                            <a class="nav-link" href="/index">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Inicio</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Administración Usuarios-->
                <div class="nav-section">
                    <span class="nav-section-title">Administración Usuarios</span> 
                    <ul>

                        <li>
                            <a class="nav-link" asp-page="/ModuloTiposIdentificacion/TiposIdentificacion">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Tipos de Identificación</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" asp-page="/ModuloUsuarios/Usuarios">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Usuarios</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" asp-page="/ModuloTiposUsuario/TiposUsuario">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Tipos de Usuario</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" asp-page="/ModuloEstadoUsuario/Estados">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Cambiar Estado</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" asp-page="/ModuloRoles/Roles">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Roles</span>
                            </a>
                        </li>

                    </ul>
                </div>

                <!-- Administración Instituciones -->
                <div class="nav-section">
                    <span class="nav-section-title">Administración Instituciones</span>
                    <ul>

                        <li>
                            <a class="nav-link" asp-page="/ModuloInstituciones/Instituciones">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Instituciones</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" asp-page="/ModuloCarreras/Carreras">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Carreras</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" asp-page="/ModuloAreasTrabajo/AreasTrabajo">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Áreas de Trabajo</span>
                            </a>
                        </li>

                    </ul>
                </div>

                <!-- Bitácoras -->
                <div class="nav-section">
                    <span class="nav-section-title">Bitácoras</span>
                    <ul>
                        <li>
                            <a class="nav-link" asp-page="/ModuloBitacoras/Bitacoras">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Bitácoras</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Sistema -->
                <div class="nav-section">
                    <span class="nav-section-title">Sistema</span>
                    <ul>

                        <li>
                            <a class="nav-link" asp-page="/ModuloPantallas/Pantallas">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Pantallas</span>
                            </a>
                        </li>

                        <li>
                            <a class="nav-link" asp-page="/ModuloParametros/Parametros">
                                <!-- <span class="nav-icon"></span> -->
                                <span class="nav-text">Parámetros</span>
                            </a>
                        </li>

                    </ul>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="main-panel">

            <!-- Top Header -->
            <header class="top-header">
                <div class="header-left">

                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Ocultar/Mostrar menú">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                            <line x1="9" y1="3" x2="9" y2="21"></line>
                        </svg>
                    </button>

                    <div class="breadcrumb">
                        <span class="breadcrumb-root">Carnet Digital</span>
                        <span class="breadcrumb-separator">/</span>
                        <span class="breadcrumb-current">@ViewData["Section"]</span>
                    </div>
                </div>
                <div class="user-profile">
                    <div class="user-info">
                        <span class="user-name">@ViewData["UserName"]</span>
                        <span class="user-role">@ViewData["UserRole"]</span>
                    </div>

                    <div class="user-menu">

                        <div class="user-avatar" id="userAvatar">
                            <span>@ViewData["UserInitials"]</span>
                        </div>

                        <div class="user-dropdown" id="userDropdown">

                            <form method="post" asp-page="/ModuloAuth/Logout">

                                <button type="submit" class="logout-button">
                                    Cerrar sesión
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            </header>

            <!-- Page Body -->
            <main class="content-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>