@page
@model SitioAdministrativoCarnetDigital.Pages.ModuloUsuarios.FotografiaModel
@{
    ViewData["Title"]   = "Fotografía de Usuario";
    ViewData["Section"] = "Fotografía de Usuario";
    Layout = "_Layout";
}

@* ── Estilos propios de la página ──────────────────────────────────────────── *@
<style>
    /* ── Fila de búsqueda (misma apariencia que Cambiar Estado de Usuario) ── */
    .busqueda-row {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .busqueda-row label {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-primary);
        white-space: nowrap;
    }

    .busqueda-row .form-control {
        width: 260px;
        padding: 8px 12px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
        color: var(--text-primary);
        background: var(--input-bg, #fff);
    }

    .busqueda-row .form-control:focus {
        border-color: var(--accent-color);
    }

    /* ── Alertas ─────────────────────────────────────────────────────────── */
    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .alert-success {
        background-color: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .alert-error {
        background-color: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* ── Panel de fotografía ─────────────────────────────────────────────── */
    .foto-panel {
        margin-top: 24px;
    }

    .foto-container {
        display: flex;
        align-items: flex-start;
        gap: 28px;
        flex-wrap: wrap;
    }

    /* Marco de la foto — proporción 4:3 */
    .foto-frame {
        width: 240px;
        aspect-ratio: 4 / 3;
        border-radius: 10px;
        overflow: hidden;
        border: 2px solid var(--border-color);
        background: #f1f5f9;
        flex-shrink: 0;
    }

    .foto-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Acciones a la derecha de la foto */
    .foto-acciones {
        display: flex;
        flex-direction: column;
        gap: 10px;
        justify-content: center;
    }

    .foto-correo-label {
        font-size: 13px;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }

    .foto-correo-valor {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 12px;
    }

    /* Botones de acción (mismo estilo que Instituciones) */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        border: none;
        cursor: pointer;
        transition: background 0.2s, opacity 0.2s;
        text-decoration: none;
    }

    .btn-primary {
        background-color: var(--accent-color, #4f46e5);
        color: white;
    }

    .btn-primary:hover { opacity: 0.88; }

    .btn-secondary {
        background-color: #e2e8f0;
        color: var(--text-primary);
    }

    .btn-secondary:hover { background-color: #cbd5e1; }

    .btn-danger {
        background-color: #ef4444;
        color: white;
    }

    .btn-danger:hover { background-color: #dc2626; }

    /* ── Modal de confirmación de eliminación ────────────────────────────── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(0,0,0,0.5);
        z-index: 2000;
        align-items: center;
        justify-content: center;
    }

    .modal-overlay.active { display: flex; }

    .modal {
        background: white;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .modal-header h3 {
        font-size: 17px;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 18px;
        cursor: pointer;
        color: var(--text-secondary);
        line-height: 1;
    }

    .modal-body {
        font-size: 14px;
        color: var(--text-primary);
        margin-bottom: 20px;
        line-height: 1.5;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    /* ── Modal de actualización de foto (drag & drop) ────────────────────── */
    .modal-foto {
        max-width: 500px;
    }

    .drop-zone {
        border: 2px dashed var(--border-color, #cbd5e1);
        border-radius: 10px;
        padding: 32px 20px;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        background: #f8fafc;
        position: relative;
    }

    .drop-zone.drag-over {
        border-color: var(--accent-color, #4f46e5);
        background: #eef2ff;
    }

    .drop-zone-icon {
        font-size: 40px;
        margin-bottom: 10px;
        display: block;
    }

    .drop-zone-text {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 8px;
    }

    .drop-zone-sub {
        font-size: 12px;
        color: var(--text-secondary);
        opacity: 0.75;
    }

    .drop-zone input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    /* Previsualización dentro del modal */
    .preview-frame {
        width: 100%;
        aspect-ratio: 4 / 3;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        background: #f1f5f9;
        margin-top: 14px;
        display: none;
    }

    .preview-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .foto-validation-msg {
        font-size: 13px;
        margin-top: 8px;
        padding: 8px 12px;
        border-radius: 6px;
        display: none;
    }

    .foto-validation-msg.error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
        display: block;
    }

    .foto-validation-msg.ok {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
        display: block;
    }
</style>

<div class="page-title">Fotografía de Usuario</div>

@* ── Alertas globales ──────────────────────────────────────────────────────── *@
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success">@Model.MensajeExito</div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-error">@Model.MensajeError</div>
}

@* ── Formulario de búsqueda ────────────────────────────────────────────────── *@
<div class="card">
    @* Búsqueda: misma línea que "Cambiar Estado de Usuario" *@
    <form method="post" asp-page-handler="Buscar">
        @Html.AntiForgeryToken()
        <div class="busqueda-row">
            <label for="Correo">Email del usuario</label>
            <input type="email"
                   id="Correo"
                   name="Correo"
                   class="form-control"
                   placeholder="usuario@cuc.ac.cr"
                   value="@Model.Correo"
                   autocomplete="off" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>

    @* ── Panel de fotografía: solo visible tras búsqueda exitosa ─────────── *@
    @if (Model.MostrarPanel)
    {
        <div class="foto-panel">
            <div class="foto-container">

                @* Foto o avatar *@
                <div class="foto-frame">
                    @if (!string.IsNullOrEmpty(Model.FotoActualBase64))
                    {
                        <img id="fotoActual"
                             src="data:image/jpeg;base64,@Model.FotoActualBase64"
                             alt="Fotografía del usuario" />
                    }
                    else
                    {
                        @* Avatar SVG por defecto cuando no hay foto *@
                        <img id="fotoActual"
                             src="data:image/svg+xml;base64,"
                             alt="Sin fotografía" />
                    }
                </div>

                @* Acciones *@
                <div class="foto-acciones">
                    <div class="foto-correo-label">Usuario</div>
                    <div class="foto-correo-valor">@Model.Correo</div>

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="abrirModalActualizar()">
                        ✏️ Actualizar fotografía
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            onclick="abrirModalEliminar()">
                        🗑️ Eliminar fotografía
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@* ── Modal: Confirmar eliminación ──────────────────────────────────────────── *@
<div class="modal-overlay" id="modalEliminar">
    <div class="modal">
        <div class="modal-header">
            <h3>Confirmar Eliminación</h3>
            <button class="modal-close" onclick="cerrarModalEliminar()">✕</button>
        </div>
        <div class="modal-body">
            ¿Realmente desea eliminar la fotografía del usuario
            <strong>@Model.Correo</strong>?
        </div>
        <form method="post" asp-page-handler="Eliminar">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Correo" value="@Model.Correo" />
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cerrarModalEliminar()">No</button>
                <button type="submit" class="btn btn-danger">Sí, eliminar</button>
            </div>
        </form>
    </div>
</div>

@* ── Modal: Actualizar fotografía (drag & drop) ─────────────────────────────── *@
<div class="modal-overlay" id="modalActualizar">
    <div class="modal modal-foto">
        <div class="modal-header">
            <h3>Actualizar Fotografía</h3>
            <button class="modal-close" onclick="cerrarModalActualizar()">✕</button>
        </div>

        @* La validación y conversión a Base64 la hace el JS antes de enviar *@
        <form method="post" asp-page-handler="Actualizar" id="formActualizar">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Correo"     value="@Model.Correo" />
            @* fotoBase64Hidden se rellena con JS antes del submit *@
            <input type="hidden" name="FotoBase64" id="fotoBase64Hidden" />

            @* Zona drag & drop *@
            <div class="drop-zone"
                 id="dropZone"
                 ondragover="onDragOver(event)"
                 ondragleave="onDragLeave(event)"
                 ondrop="onDrop(event)">
                <span class="drop-zone-icon">🖼️</span>
                <p class="drop-zone-text">
                    Arrastra la fotografía aquí o haz clic para seleccionarla
                </p>
                <p class="drop-zone-sub">
                    JPG · PNG · Proporción 4:3 · Máximo 1 MB
                </p>
                <input type="file"
                       id="inputFoto"
                       accept="image/jpeg,image/png,image/gif,image/webp"
                       onchange="onFileSelected(this.files[0])" />
            </div>

            @* Mensaje de validación de la imagen *@
            <div class="foto-validation-msg" id="validacionMsg"></div>

            @* Previsualización 4:3 *@
            <div class="preview-frame" id="previewFrame">
                <img id="previewImg" src="" alt="Previsualización" />
            </div>

            <div class="modal-footer" style="margin-top:16px;">
                <button type="button" class="btn btn-secondary" onclick="cerrarModalActualizar()">Cancelar</button>
                <button type="submit"
                        class="btn btn-primary"
                        id="btnActualizar"
                        disabled>
                    Actualizar Fotografía
                </button>
            </div>
        </form>
    </div>
</div>

@* ── JavaScript ─────────────────────────────────────────────────────────────── *@
<script>
    // ── Control de modales ──────────────────────────────────────────────────

    function abrirModalEliminar() {
        document.getElementById('modalEliminar').classList.add('active');
    }

    function cerrarModalEliminar() {
        document.getElementById('modalEliminar').classList.remove('active');
    }

    function abrirModalActualizar() {
        resetearModalFoto();
        document.getElementById('modalActualizar').classList.add('active');
    }

    function cerrarModalActualizar() {
        document.getElementById('modalActualizar').classList.remove('active');
        resetearModalFoto();
    }

    function resetearModalFoto() {
        document.getElementById('inputFoto').value            = '';
        document.getElementById('fotoBase64Hidden').value     = '';
        document.getElementById('previewImg').src             = '';
        document.getElementById('previewFrame').style.display = 'none';
        document.getElementById('btnActualizar').disabled     = true;
        setValidacionMsg('', '');
    }

    // ── Drag & Drop ─────────────────────────────────────────────────────────

    function onDragOver(e) {
        e.preventDefault();
        document.getElementById('dropZone').classList.add('drag-over');
    }

    function onDragLeave(e) {
        document.getElementById('dropZone').classList.remove('drag-over');
    }

    function onDrop(e) {
        e.preventDefault();
        document.getElementById('dropZone').classList.remove('drag-over');
        const file = e.dataTransfer.files[0];
        if (file) procesarArchivo(file);
    }

    function onFileSelected(file) {
        if (file) procesarArchivo(file);
    }

    // ── Procesamiento y validación de la imagen ─────────────────────────────

    function procesarArchivo(file) {
        // 1. Tipo de archivo
        const tiposPermitidos = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
        if (!tiposPermitidos.includes(file.type)) {
            setValidacionMsg('Solo se permiten imágenes (JPG, PNG, GIF, WEBP).', 'error');
            limpiarPreview();
            return;
        }

        // 2. Tamaño máximo 1 MB
        const MAX_BYTES = 1 * 1024 * 1024;
        if (file.size > MAX_BYTES) {
            setValidacionMsg(
                `La imagen pesa ${(file.size / 1024 / 1024).toFixed(2)} MB. El máximo permitido es 1 MB.`,
                'error'
            );
            limpiarPreview();
            return;
        }

        // 3. Leer como Base64 para validar proporción
        const reader = new FileReader();
        reader.onload = function (e) {
            const base64Data = e.target.result;           // data:image/...;base64,XXXX
            const img = new Image();
            img.onload = function () {
                // Validación estricta 4:3 — sin tolerancia
                const w = img.naturalWidth;
                const h = img.naturalHeight;

                if (w * 3 !== h * 4) {
                    setValidacionMsg(
                        `La imagen tiene proporción ${w}×${h}, que no es 4:3 exacto. ` +
                        `Ejemplos válidos: 400×300, 800×600, 1200×900.`,
                        'error'
                    );
                    limpiarPreview();
                    return;
                }

                // Validación pasada: mostrar previsualización y habilitar botón
                document.getElementById('previewImg').src             = base64Data;
                document.getElementById('previewFrame').style.display = 'block';

                // Guardar solo la parte Base64 (sin el prefijo data:...;base64,)
                const soloBase64 = base64Data.split(',')[1];
                document.getElementById('fotoBase64Hidden').value = soloBase64;
                document.getElementById('btnActualizar').disabled  = false;

                setValidacionMsg(
                    `Imagen válida: ${w}×${h} px · ${(file.size / 1024).toFixed(0)} KB`,
                    'ok'
                );
            };
            img.onerror = function () {
                setValidacionMsg('No se pudo leer la imagen. Intente con otro archivo.', 'error');
                limpiarPreview();
            };
            img.src = base64Data;
        };
        reader.readAsDataURL(file);
    }

    function setValidacionMsg(texto, tipo) {
        const el = document.getElementById('validacionMsg');
        el.textContent  = texto;
        el.className    = 'foto-validation-msg';
        if (tipo) el.classList.add(tipo);
    }

    function limpiarPreview() {
        document.getElementById('previewImg').src             = '';
        document.getElementById('previewFrame').style.display = 'none';
        document.getElementById('fotoBase64Hidden').value     = '';
        document.getElementById('btnActualizar').disabled     = true;
    }

    // Cerrar modales al hacer clic fuera del contenido
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', e => {
                if (e.target === overlay) overlay.classList.remove('active');
            });
        });
    });
</script>
