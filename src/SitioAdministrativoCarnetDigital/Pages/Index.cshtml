@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
    ViewData["Section"] = "Inicio";
}

<!-- Bienvenida -->
<div class="card" style="text-align:center; padding: 56px 24px;">
    <div class="brand-logo" style="width:64px; height:64px; margin: 0 auto 20px;">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <circle cx="9" cy="10" r="2"></circle>
            <path d="M15 8h2"></path>
            <path d="M15 12h2"></path>
            <path d="M7 15h10"></path>
        </svg>
    </div>
    <h1 class="page-title" style="margin-bottom:8px;">Bienvenido, @Model.NombreUsuario</h1>
    <p style="color: var(--text-secondary); font-size:15px;">
        Sistema de Carnet Digital &mdash; Colegio Universitario de Cartago
    </p>
</div>
